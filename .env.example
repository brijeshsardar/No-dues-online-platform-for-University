# CT University Secure Clearance System Environment Configuration
# Copy to .env and configure for production

# Server Port & Mode
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://nodues_user:SuperSecurePassword2026@localhost:5432/ct_university_nodues?schema=public&sslmode=prefer"

# JWT Authentication Secrets (Must be 64+ random characters in production)
JWT_SECRET=ct_university_super_secure_jwt_secret_key_2026_981249_random_entropy
JWT_EXPIRES_IN=2h
SESSION_SECRET=ct_session_secure_entropy_key_7781293_alpha_omega
COOKIE_SECRET=ct_cookie_secret_991823_prod_grade

# Multi-Factor Authentication (MFA)
MFA_APP_NAME="CT University Clearance"

# Verification Endpoint Base URL
VERIFY_BASE_URL=http://localhost:5173/verify

# Digital Signature Passphrase
SIGNING_KEY_PASSPHRASE=ct_uni_exam_clearance_sign_key_pass_2026
